# انسخ هذا الملف إلى .env واملأ القيم من حسابات مالك النظام.
PORT=8787
# ضع عنوان مشروع Supabase، مثال https://xxxx.supabase.co
SUPABASE_URL=
# Service Role Key يبقى بالخادم فقط ولا يوضع داخل المتصفح أو يرسل للزبون
SUPABASE_SERVICE_ROLE_KEY=
# رمز مدير المخزون لتهيئة الأرصدة الافتتاحية (32 حرفاً عشوائياً على الأقل)، يبقى على الخادم فقط
INVENTORY_ADMIN_TOKEN=
# رمز منفصل لقراءة لوحة الإدارة المجمعة لكل الفروع (32 حرفاً عشوائياً على الأقل)
ADMIN_DASHBOARD_TOKEN=
# مفتاح OpenAI يبقى بالخادم فقط
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# غيّر الرمز الافتراضي إلى رمز طويل وعشوائي لكل فرع. مثال JSON:
BRANCH_TOKENS_JSON={"BR-001":"CHANGE-THIS-TO-A-LONG-RANDOM-TOKEN"}
# عناوين المواقع المسموح لها بالاتصال، افصل بينها بفاصلة. للتطوير المحلي يمكن تركه فارغاً.
CORS_ORIGINS=
# لا تستخدم رموزاً قصيرة أو افتراضية. لكل فرع رمز عشوائي فريد بطول 32 حرفاً على الأقل.
# في الإنتاج اضبط NODE_ENV=production وCORS_ORIGINS على عناوين الواجهة الموثوقة فقط.
NODE_ENV=development
